flowchart LR
    A[Outline intent] --> B[Pick slide pattern]
    B --> C[Generate diagram or chart asset]
    C --> D[Compose slide with notes]
    D --> E{Run rendered fit check}
    E -- Pass --> F[Rehearse and present]
    E -- Fail --> G[Split or redesign slide]
    G --> D

    style A fill:#1d4ed8,stroke:#93c5fd,color:#f8fafc,stroke-width:2px
    style B fill:#0891b2,stroke:#67e8f9,color:#ecfeff,stroke-width:2px
    style C fill:#0f766e,stroke:#5eead4,color:#f0fdfa,stroke-width:2px
    style D fill:#7c3aed,stroke:#c4b5fd,color:#f5f3ff,stroke-width:2px
    style E fill:#f59e0b,stroke:#fde68a,color:#111827,stroke-width:2px
    style F fill:#16a34a,stroke:#86efac,color:#f0fdf4,stroke-width:2px
    style G fill:#dc2626,stroke:#fca5a5,color:#fff1f2,stroke-width:2px

    linkStyle 0,1,2,3 stroke:#60a5fa,stroke-width:3px
    linkStyle 4 stroke:#22c55e,stroke-width:3px
    linkStyle 5 stroke:#f97316,stroke-width:3px,stroke-dasharray:6 4
    linkStyle 6 stroke:#f97316,stroke-width:3px,stroke-dasharray:6 4
