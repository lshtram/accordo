{
  "name": "accordo-drawing",
  "displayName": "Accordo Drawing Tools",
  "publisher": "accordo",
  "version": "0.1.0",
  "description": "Accordo IDE Drawing Tools — collaborative Mermaid + Excalidraw drawings with merge/placement",
  "categories": ["Other"],
  "extensionKind": ["workspace"],
  "activationEvents": ["onStartupFinished"],
  "extensionDependencies": ["accordo.accordo-bridge"],
  "type": "module",
  "main": "./dist/extension.js",
  "scripts": {
    "build": "tsc -b && pnpm build:webview",
    "build:host": "tsc -b",
    "build:webview": "echo 'drawing webview stub'",
    "clean": "rm -rf dist *.tsbuildinfo",
    "package": "vsce package --no-dependencies",
    "test": "vitest run",
    "test:watch": "vitest watch",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.webview.json --noEmit",
    "lint": "echo 'no lint configured yet'"
  },
  "dependencies": {
    "@accordo/bridge-types": "workspace:*",
    "@accordo/capabilities": "workspace:*",
    "@excalidraw/excalidraw": "0.17.6",
    "@excalidraw/mermaid-to-excalidraw": "^2.2.2",
    "mermaid": "11.12.3"
  },
  "devDependencies": {
    "@accordo/bridge-types": "workspace:*",
    "@types/node": "^20.0.0",
    "@types/vscode": "^1.100.0",
    "happy-dom": "^20.9.0",
    "jsdom": "^26.1.0",
    "typescript": "^5.7.0",
    "vitest": "^3.0.0"
  },
  "contributes": {
    "customEditors": [
      {
        "viewType": "accordo-drawing.drawingEditor",
        "displayName": "Accordo Drawing",
        "selector": [{ "filenamePattern": "*.excalidraw" }],
        "priority": "default"
      }
    ],
    "commands": [
      {
        "command": "accordo-drawing.open",
        "title": "Accordo: Open Drawing"
      }
    ],
    "menus": {
      "explorer/context": [
        {
          "command": "accordo-drawing.open",
          "when": "resourceExtname == .mmd",
          "group": "navigation"
        }
      ]
    }
  },
  "engines": {
    "node": ">=20",
    "vscode": "^1.100.0"
  }
}
